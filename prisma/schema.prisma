// Prisma 7: the connection URL lives in prisma.config.ts (CLI/migrate) and in the
// PrismaPg driver adapter (runtime, src/server/db.ts) — never in this file.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  votes         Vote[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Sketch {
  id          String   @id @default(cuid())
  title       String
  collection  String?
  description String?
  images      Image[]
  rating      Float    @default(1000.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  votesWon    Vote[]   @relation("VotesWon")
  votesLost   Vote[]   @relation("VotesLost")
}

// Voting is sign-in + allowlist gated (2026-07-10 UX decision): rows here are the
// approved voter emails, managed from /admin. ADMIN_EMAILS are implicitly allowed.
model AllowedVoter {
  email   String   @id
  addedAt DateTime @default(now())
}

// One row per head-to-head vote — the durable event log behind the mutable Elo
// rating (per-user stats, admin analytics, and a full Elo replay if the formula
// ever changes). userId is null on pre-gate historical votes (anonymous era).
model Vote {
  id        String   @id @default(cuid())
  userId    String?
  winnerId  String
  loserId   String
  createdAt DateTime @default(now())

  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  winner Sketch @relation("VotesWon", fields: [winnerId], references: [id], onDelete: Cascade)
  loser  Sketch @relation("VotesLost", fields: [loserId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([winnerId])
  @@index([loserId])
}

model Image {
  id       String @id @default(cuid())
  fileName String
  sketchId String
  sketch   Sketch @relation(fields: [sketchId], references: [id], onDelete: Cascade)
}
