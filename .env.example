# Copy to .env for local dev. Production values live in the Amplify app env vars
# (operative) + SSM /amplify/sketchranker/* (inventory) — see the monorepo KB:
# workspace/projects/open-source/sketch-ranker.md.

# Local: a throwaway Docker Postgres works fine.
# Production: Aurora Serverless v2 — append ?schema=public&sslmode=require&connect_timeout=30
DATABASE_URL=postgresql://postgres:dev@localhost:5432/prod?schema=public

# Google OAuth (web client in the legacy sketch-ranker GCP project;
# localhost:3000 is an authorized redirect URI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXTAUTH_SECRET=any-random-string
NEXTAUTH_URL=http://localhost:3000

# Comma-separated allowlist for /admin
ADMIN_EMAILS=you@example.com
